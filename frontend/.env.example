# Production (Netlify): VITE_API_URL = deployed Cloud Functions base URL, e.g.
# VITE_API_URL="https://asia-south1-YOUR-PROJECT.cloudfunctions.net/api"
# Local dev: leave empty and use the Functions emulator via vite proxy.
VITE_API_URL=""

# Firebase web app config (public client keys — safe to expose; NEVER put Admin
# SDK credentials or service-account JSON in the frontend). Values come from
# Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
