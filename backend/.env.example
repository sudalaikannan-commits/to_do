# --- Database (PostgreSQL, required for production) ---
DATABASE_URL="postgresql://ationic:changeme@localhost:5432/ationic?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# --- Auth (generate a strong secret for production!) ---
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me-use-32-plus-chars-in-prod"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="ationic_token"
COOKIE_SECURE="false"

# --- First admin provisioning (used by prisma/seed.ts, never commit real values) ---
ADMIN_EMAIL="admin@ationic.agency"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Ationic Admin"
