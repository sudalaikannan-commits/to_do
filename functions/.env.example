# Functions runtime config (NEVER commit real secrets)
# Local emulator + migration script read these from functions/.env

# Firebase project id (must match .firebaserc default after you run `firebase use --add`)
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Comma-separated allowed frontend origins (Netlify URL + local dev)
ALLOWED_ORIGINS="http://localhost:5173,https://your-site.netlify.app"

# --- PG→Firestore migration script only (functions/migrate/) ---
# Source PostgreSQL (local compose DB or Neon). Read-only usage.
PGDATABASE_URL="postgresql://ationic:changeme@localhost:5432/ationic"
# Service-account JSON path for firebase-admin (or use Application Default Credentials).
# GOOGLE_APPLICATION_CREDENTIALS="C:/secure/ationic-service-account.json"
# Optional: point admin SDK at local emulators instead of production:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
